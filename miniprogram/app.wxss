page { background: #f7f2e9; color: #173f3e; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 32rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx 160rpx; }
.hero { position: relative; overflow: hidden; padding: 40rpx; border-radius: 32rpx; color: #fffdf8; background: linear-gradient(135deg, #0f5c56, #18766e); box-shadow: 0 18rpx 45rpx rgba(15,92,86,.18); }
.hero::after { content: ''; position: absolute; width: 220rpx; height: 220rpx; right: -70rpx; top: -90rpx; border: 2rpx solid rgba(255,255,255,.22); border-radius: 50%; }
.eyebrow { font-size: 26rpx; letter-spacing: 4rpx; opacity: .82; }
.hero-title { margin-top: 14rpx; font-size: 48rpx; line-height: 1.18; font-weight: 700; }
.hero-copy { margin-top: 18rpx; line-height: 1.7; color: rgba(255,250,242,.82); }
.section-title { display: flex; align-items: baseline; justify-content: space-between; margin: 40rpx 6rpx 20rpx; font-size: 34rpx; font-weight: 700; }
.section-subtitle { color: #5f6964; font-size: 26rpx; font-weight: 400; }
.card { margin-bottom: 22rpx; padding: 28rpx; border: 1rpx solid #d8d6cd; border-radius: 26rpx; background: #fffdf8; box-shadow: 0 8rpx 28rpx rgba(49,60,52,.06); }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.avatar { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 20rpx; border-radius: 24rpx; color: white; font-weight: 700; }
.title { color: #173f3e; font-size: 32rpx; font-weight: 700; }
.muted { color: #5f6964; }
.small { font-size: 26rpx; }
.price { color: #d95f45; font-size: 36rpx; font-weight: 800; }
.tag { display: inline-flex; margin-right: 12rpx; padding: 7rpx 16rpx; border-radius: 99rpx; background: #e3efeb; color: #0f5c56; font-size: 26rpx; }
.tag.coral { background: #f9ddd4; color: #a64535; }
.tag.gray { background: #eeeae2; color: #70766f; }
.meta { margin-top: 18rpx; line-height: 1.6; color: #59635d; }
.media-grid { display: flex; gap: 12rpx; margin-top: 20rpx; }
.media { width: 190rpx; height: 190rpx; border-radius: 18rpx; background: #e7e3da; object-fit: cover; }
.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; margin-top: 24rpx; }
button { box-sizing: border-box; min-height: 96rpx; margin: 0; border: 0; border-radius: 18rpx; font-size: 28rpx; line-height: 2.6; }
button::after { border: 0; }
.btn-primary { padding: 0 28rpx; color: white; background: #0f5c56; }
.btn-coral { padding: 0 28rpx; color: white; background: #d95f45; }
.btn-ghost { padding: 0 24rpx; color: #0f5c56; background: #e3efeb; }
.btn-danger { padding: 0 24rpx; color: #a64535; background: #f9ddd4; }
.btn-wide { width: 100%; margin-top: 26rpx; }
button[disabled] { opacity: .55; }
.field { margin-bottom: 24rpx; }
.label { display: block; margin: 0 4rpx 12rpx; color: #41514c; font-size: 28rpx; font-weight: 600; }
.input, .textarea, .picker { box-sizing: border-box; width: 100%; min-height: 96rpx; padding: 24rpx; border: 1rpx solid #d8d6cd; border-radius: 18rpx; background: #fffdf8; }
.textarea { min-height: 180rpx; }
.error { margin: 18rpx 0; padding: 20rpx 24rpx; border-radius: 18rpx; color: #9b3e30; background: #fbe1da; }
.notice { margin: 18rpx 0; padding: 20rpx 24rpx; border-radius: 18rpx; color: #176661; background: #e3efeb; }
.empty { margin-top: 36rpx; padding: 80rpx 32rpx; border: 2rpx dashed #d8d1c4; border-radius: 28rpx; text-align: center; color: #7b827d; }
.empty-mark { display: block; margin-bottom: 16rpx; color: #d95f45; font-size: 27rpx; font-weight: 700; letter-spacing: 2rpx; }
.loading { padding: 80rpx 0; text-align: center; color: #77817b; }
.fab { position: fixed; right: 32rpx; bottom: calc(150rpx + env(safe-area-inset-bottom)); z-index: 9; padding: 0 32rpx; border-radius: 99rpx; color: white; background: #d95f45; box-shadow: 0 12rpx 30rpx rgba(217,95,69,.28); }
.divider { height: 1rpx; margin: 24rpx 0; background: #e9e3da; }
.choice { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #eee8de; }
.choice:last-child { border: 0; }
.dot { width: 34rpx; height: 34rpx; margin-right: 18rpx; border: 2rpx solid #b8bcb6; border-radius: 50%; }
.dot.selected { border-color: #0f6664; background: #0f6664; box-shadow: inset 0 0 0 8rpx #fffaf2; }
.status { padding: 8rpx 16rpx; border-radius: 99rpx; background: #eeeae2; font-size: 26rpx; }
.status.approved, .status.accept { color: #176661; background: #dcefe7; }
.status.rejected, .status.reject, .status.cancelled { color: #a64535; background: #f9ddd4; }
.status.pending { color: #9a671d; background: #f8e9c8; }
.status.expired { color: #606762; background: #e7e5df; }
.safe-bottom { height: env(safe-area-inset-bottom); }
