page { background: #f5f6f8; color: #17181a; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 30rpx; }
.page { box-sizing: border-box; min-height: 100vh; padding: 32rpx 32rpx calc(150rpx + env(safe-area-inset-bottom)); }
.page-header { display: flex; align-items: flex-end; justify-content: space-between; margin: 16rpx 0 34rpx; }
.page-kicker { margin-bottom: 8rpx; color: #9a9da3; font-size: 24rpx; font-weight: 600; letter-spacing: 2rpx; }
.page-title { color: #111214; font-size: 52rpx; line-height: 1.15; font-weight: 800; letter-spacing: -1rpx; }
.page-subtitle { margin-top: 12rpx; color: #7b7f86; font-size: 27rpx; line-height: 1.55; }
.section-title { display: flex; align-items: center; justify-content: space-between; margin: 42rpx 4rpx 20rpx; color: #202226; font-size: 32rpx; font-weight: 700; }
.section-subtitle { color: #92969d; font-size: 25rpx; font-weight: 400; }
.card { box-sizing: border-box; margin-bottom: 20rpx; padding: 28rpx; border: 1rpx solid #eceef1; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(20,24,30,.04); }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.avatar { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 20rpx; border-radius: 50%; color: #fff; font-size: 28rpx; font-weight: 700; }
.avatar.mini { width: 60rpx; height: 60rpx; margin-right: 16rpx; font-size: 24rpx; }
.title { color: #1d1f22; font-size: 31rpx; font-weight: 700; }
.muted { color: #8a8e95; }
.small { font-size: 25rpx; }
.price { color: #111214; font-size: 36rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.meta { margin-top: 18rpx; color: #555960; line-height: 1.7; }
.tag { display: inline-flex; align-items: center; min-height: 42rpx; padding: 0 16rpx; border-radius: 99rpx; color: #666a71; background: #f0f1f3; font-size: 23rpx; }
.tag.orange { color: #d64c21; background: #fff0ea; }
.tag.green { color: #168552; background: #eaf8f1; }
.divider { height: 1rpx; margin: 26rpx 0; background: #eff0f2; }
.media-grid { display: flex; gap: 12rpx; margin-top: 22rpx; overflow: hidden; }
.media { width: 190rpx; height: 190rpx; border-radius: 18rpx; background: #eef0f2; }
.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; margin-top: 24rpx; }
button { box-sizing: border-box; min-height: 88rpx; margin: 0; border: 0; border-radius: 18rpx; font-size: 28rpx; font-weight: 600; line-height: 88rpx; }
button::after { border: 0; }
.btn-primary { padding: 0 30rpx; color: #fff; background: #17181a; }
.btn-accent { padding: 0 30rpx; color: #fff; background: #ff6436; }
.btn-soft { padding: 0 26rpx; color: #31343a; background: #f0f1f3; }
.btn-success { padding: 0 26rpx; color: #fff; background: #14a064; }
.btn-danger { padding: 0 26rpx; color: #ce452c; background: #fff0ed; }
.btn-wide { width: 100%; margin-top: 24rpx; }
button[disabled] { opacity: .45; }
.field { margin-bottom: 30rpx; }
.label { display: block; margin: 0 2rpx 12rpx; color: #3c3f44; font-size: 27rpx; font-weight: 600; }
.required { color: #ff6436; }
.input,.textarea,.picker { box-sizing: border-box; width: 100%; min-height: 94rpx; padding: 23rpx 24rpx; border: 2rpx solid #e7e9ec; border-radius: 18rpx; color: #1c1e21; background: #fafbfc; }
.input:focus,.textarea:focus { border-color: #17181a; background: #fff; }
.textarea { min-height: 190rpx; line-height: 1.6; }
.error { margin: 20rpx 0; padding: 22rpx 24rpx; border-radius: 18rpx; color: #b53e2b; background: #fff0ed; line-height: 1.5; }
.notice { margin: 20rpx 0; padding: 22rpx 24rpx; border-radius: 18rpx; color: #4f545b; background: #eef4ff; line-height: 1.55; }
.loading { padding: 110rpx 0; color: #8f939a; text-align: center; }
.empty { margin-top: 24rpx; padding: 88rpx 36rpx; border-radius: 24rpx; color: #92969d; background: #fff; text-align: center; line-height: 1.7; }
.empty-mark { display: block; margin-bottom: 14rpx; color: #292b2f; font-size: 34rpx; font-weight: 800; }
.status { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 16rpx; border-radius: 99rpx; color: #73777e; background: #f0f1f3; font-size: 23rpx; font-weight: 600; }
.status.pending { color: #b26114; background: #fff4df; }
.status.approved,.status.accept { color: #14814e; background: #e9f8f0; }
.status.rejected,.status.reject,.status.cancelled { color: #c7472f; background: #fff0ed; }
.status.expired { color: #72767c; background: #eff0f2; }
.fab { position: fixed; right: 32rpx; bottom: calc(132rpx + env(safe-area-inset-bottom)); z-index: 9; min-height: 92rpx; padding: 0 34rpx; border-radius: 46rpx; color: #fff; background: #17181a; box-shadow: 0 14rpx 34rpx rgba(15,17,20,.22); }
.segmented { display: flex; padding: 8rpx; border-radius: 20rpx; background: #e9ebee; }
.segment { flex: 1; min-height: 70rpx; border-radius: 15rpx; color: #777b82; text-align: center; font-size: 27rpx; line-height: 70rpx; }
.segment.active { color: #15171a; background: #fff; box-shadow: 0 4rpx 16rpx rgba(15,18,22,.08); font-weight: 700; }
.choice { display: flex; align-items: center; min-height: 98rpx; border-bottom: 1rpx solid #eff0f2; }
.choice:last-child { border-bottom: 0; }
.dot { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; margin-right: 18rpx; border: 2rpx solid #c8cbd0; border-radius: 50%; }
.dot.selected { border-color: #ff6436; background: #ff6436; box-shadow: inset 0 0 0 9rpx #fff; }


.page-title { font-size:48rpx; line-height:1.25; }
.page-subtitle,.muted { color:#71786f; }
.page { padding-bottom:calc(140rpx + env(safe-area-inset-bottom)); }
.page-header { align-items:center; gap:20rpx; }
.btn-accent { background:#e9683b; }.btn-success { color:#19633f; background:#e5f3e8; }.btn-danger { color:#ad442e; background:#fff0e7; }
.empty-art { width:280rpx; height:180rpx; display:block; margin:0 auto 20rpx; }
.photo-layout { display:grid; gap:12rpx; margin-top:24rpx; }
.photo-layout image { display:block; width:100%; min-width:0; height:194rpx; border-radius:16rpx; background:#f1f0eb; }
.photos-1 { grid-template-columns:1fr; }.photos-1 image { height:380rpx; }
.photos-2 { grid-template-columns:repeat(2,minmax(0,1fr)); }.photos-2 image { height:280rpx; }
.photos-3 { grid-template-columns:repeat(3,minmax(0,1fr)); }
.vote-meter { display:flex; height:12rpx; overflow:hidden; border-radius:99rpx; margin-top:26rpx; background:#eeeee8; }
.meter-yes { background:#6caa7a; }.meter-no { background:#e99775; }
button { transition:opacity .15s,background-color .15s; }
