<view class="page">
  <view class="page-header"><view><view class="page-title">好友</view><view class="page-subtitle">只邀请真正了解你的人</view></view></view>
  <view class="add-friend"><text class="label">输入好友邀请码</text><view class="row"><input class="invite-input" maxlength="20" placeholder="例如 ABC123" value="{{invite}}" bindinput="inputInvite"/><button loading="{{submitting}}" disabled="{{submitting}}" bindtap="addFriend">添加</button></view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在更新好友…</view>
  <block wx:if="{{!loading}}"><block wx:if="{{incoming.length}}"><view class="section-title"><text>新的申请</text><text class="section-subtitle">{{incoming.length}}</text></view><view wx:for="{{incoming}}" wx:key="id" class="request-card"><view class="row"><view class="avatar" style="background:{{item.user.color}}">{{item.user.initial}}</view><view class="grow"><view class="title">{{item.user.name}}</view><view class="muted small">想加你为好友</view></view></view><view class="request-actions"><button class="btn-primary" data-id="{{item.id}}" data-accept="true" disabled="{{submitting}}" bindtap="respond">接受</button><button class="btn-soft" data-id="{{item.id}}" data-accept="false" disabled="{{submitting}}" bindtap="respond">拒绝</button></view></view></block>
  <view class="section-title"><text>我的好友</text><text class="section-subtitle">{{friends.length}} 人</text></view><view wx:if="{{!friends.length}}" class="empty"><text class="empty-mark">还没有好友</text><view>分享你的邀请码，或输入朋友的邀请码。</view></view><view class="friend-list" wx:if="{{friends.length}}"><view wx:for="{{friends}}" wx:key="id" class="friend-row"><view class="avatar" style="background:{{item.color}}">{{item.initial}}</view><view class="grow"><view class="title">{{item.name}}</view><view class="muted small">邀请码 {{item.code}}</view></view><button data-id="{{item.id}}" bindtap="remove">移除</button></view></view>
  <block wx:if="{{outgoing.length}}"><view class="section-title"><text>等待通过</text></view><view wx:for="{{outgoing}}" wx:key="id" class="pending-row"><view class="avatar mini" style="background:{{item.user.color}}">{{item.user.initial}}</view><text>{{item.user.name}}</text><label>等待对方接受</label></view></block></block>
</view>
