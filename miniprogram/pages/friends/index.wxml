<view class="page">
  <view class="card add-card"><text class="label">好友邀请码</text><view class="row"><input class="input invite-input" maxlength="20" placeholder="输入好友分享的编号" value="{{invite}}" bindinput="inputInvite"/><button class="btn-primary add-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="addFriend">发送申请</button></view></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{loading}}" class="loading">正在更新好友…</view>
  <block wx:if="{{!loading}}"><view wx:if="{{incoming.length}}" class="section-title"><text>待处理申请</text><text class="section-subtitle">{{incoming.length}} 条</text></view><view wx:for="{{incoming}}" wx:key="id" class="card friend-row"><view class="row grow"><view class="avatar" style="background:{{item.user.color}}">{{item.user.initial}}</view><view class="grow"><view class="title">{{item.user.name}}</view><view class="muted small">编号 {{item.user.code}}</view></view></view><view class="request-actions"><button class="btn-primary" data-id="{{item.id}}" data-accept="true" disabled="{{submitting}}" bindtap="respond">接受</button><button class="btn-ghost" data-id="{{item.id}}" data-accept="false" disabled="{{submitting}}" bindtap="respond">拒绝</button></view></view>
  <view class="section-title"><text>我的好友</text><text class="section-subtitle">{{friends.length}} 人</text></view><view wx:if="{{!friends.length}}" class="empty"><text class="empty-mark">好友</text>输入邀请码，建立你的购买参谋团</view><view wx:for="{{friends}}" wx:key="id" class="card friend-row row"><view class="avatar" style="background:{{item.color}}">{{item.initial}}</view><view class="grow"><view class="title">{{item.name}}</view><view class="muted small">编号 {{item.code}}</view></view><button class="btn-danger" data-id="{{item.id}}" bindtap="remove">移除</button></view>
  <view wx:if="{{outgoing.length}}" class="section-title"><text>已发送申请</text></view><view wx:for="{{outgoing}}" wx:key="id" class="notice">等待 {{item.user.name}} 接受</view></block>
</view>
