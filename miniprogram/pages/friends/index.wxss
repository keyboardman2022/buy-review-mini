.add-friend { padding: 28rpx; border-radius: 26rpx; background: #17181a; }.add-friend .label { color: rgba(255,255,255,.72); }.invite-input { box-sizing: border-box; flex: 1; height: 88rpx; padding: 0 22rpx; border-radius: 16rpx; color: #17181a; background: #fff; }.add-friend button { min-width: 120rpx; margin-left: 12rpx; color: #fff; background: #ff6436; }.request-card { margin-bottom: 18rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; }.request-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 24rpx; }.friend-list { overflow: hidden; border-radius: 24rpx; background: #fff; }.friend-row { display: flex; align-items: center; min-height: 118rpx; margin-left: 28rpx; padding-right: 24rpx; border-bottom: 1rpx solid #eff0f2; }.friend-row:last-child { border: 0; }.friend-row button { min-height: 62rpx; padding: 0 18rpx; color: #b74a36; background: #fff0ed; font-size: 23rpx; line-height: 62rpx; }.pending-row { display: flex; align-items: center; margin-bottom: 12rpx; padding: 22rpx; border-radius: 20rpx; background: #fff; }.pending-row label { margin-left: auto; color: #9a9ea5; font-size: 23rpx; }
