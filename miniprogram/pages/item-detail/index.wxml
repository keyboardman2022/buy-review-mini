<view class="page">
  <view wx:if="{{loading}}" class="loading">正在打开商品…</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{item}}"><view class="detail-card"><view class="row"><view class="avatar" style="background:{{item.owner.color}}">{{item.owner.initial}}</view><view class="grow"><view class="title">{{item.owner.name}}</view><view class="muted small">{{item.timeText}}</view></view><text class="tag">{{item.visibility === 'private' ? '仅自己' : '好友可见'}}</text></view><view class="detail-title">{{item.title}}</view><view class="detail-price">{{item.priceText}}</view><view class="reason">{{item.reason}}</view><view wx:if="{{item.category}}" class="tag orange category">{{item.category}}</view><view class="media-grid"><image wx:for="{{item.photos}}" wx:key="*this" class="media" src="{{item}}" mode="aspectFill"/></view><view wx:if="{{item.link}}" class="link-box">商品链接：{{item.link}}</view><view class="reaction-row"><button class="reaction {{item.myReaction === 1 ? 'positive' : ''}}" data-value="1" disabled="{{reacting}}" bindtap="react">值得买 {{item.likes}}</button><button class="reaction {{item.myReaction === -1 ? 'negative' : ''}}" data-value="-1" disabled="{{reacting}}" bindtap="react">先别买 {{item.dislikes}}</button></view><view wx:if="{{isOwner}}" class="owner-actions"><button class="btn-accent" bindtap="createApproval">请好友审批</button><button class="btn-soft" bindtap="editItem">编辑</button><button class="btn-danger" bindtap="deleteItem">移除</button></view></view>
  <view class="section-title"><text>朋友的看法</text><text class="section-subtitle">{{comments.length}} 条</text></view><view class="comment-box"><text class="label">说点具体的</text><textarea class="textarea" maxlength="300" placeholder="这件东西值不值？为什么？" value="{{comment}}" bindinput="inputComment"/><button class="btn-primary btn-wide" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitComment">发表评论</button></view><view wx:if="{{!comments.length}}" class="empty"><text class="empty-mark">还没有评论</text><view>你的看法可能正好能帮到朋友。</view></view><view wx:for="{{comments}}" wx:key="id" class="comment-card"><view class="row"><view class="avatar mini" style="background:{{item.user.color}}">{{item.user.initial}}</view><view class="grow"><view class="title">{{item.user.name}}</view><view class="muted small">{{item.createdText}}</view></view><text wx:if="{{item.canDelete}}" class="delete-link" data-id="{{item.id}}" bindtap="deleteComment">删除</text></view><view class="comment-text">{{item.text}}</view></view></block>
</view>
