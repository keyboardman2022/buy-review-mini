<view class="page"><view wx:if="{{loading}}" class="loading">正在打开商品…</view><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{item}}"><view class="card detail"><view class="row"><view class="avatar" style="background:{{item.owner.color}}">{{item.owner.initial}}</view><view class="grow"><view class="title">{{item.owner.name}}</view><view class="muted small">{{item.timeText}}</view></view><text class="tag">{{item.visibility === 'private' ? '仅自己' : '好友可见'}}</text></view><view class="row between headline"><view class="detail-title grow">{{item.title}}</view><view class="price">{{item.priceText}}</view></view><view class="meta">{{item.reason}}</view><view wx:if="{{item.category}}" class="tagline"><text class="tag coral">{{item.category}}</text></view><view class="media-grid"><image wx:for="{{item.photos}}" wx:key="*this" class="media" src="{{item}}" mode="aspectFill"/></view><view wx:if="{{item.link}}" class="notice small">商品链接：{{item.link}}</view><view class="actions"><button size="mini" class="btn-ghost" data-value="1" disabled="{{reacting}}" bindtap="react">{{item.myReaction === 1 ? '已赞' : '赞'}} {{item.likes}}</button><button size="mini" class="btn-ghost" data-value="-1" disabled="{{reacting}}" bindtap="react">{{item.myReaction === -1 ? '已踩' : '踩'}} {{item.dislikes}}</button></view><view wx:if="{{isOwner}}" class="owner-actions"><button class="btn-primary" bindtap="createApproval">请好友审批</button><button class="btn-ghost" bindtap="editItem">编辑</button><button class="btn-danger" bindtap="deleteItem">删除</button></view></view>
<view class="section-title"><text>朋友怎么说</text><text class="section-subtitle">{{comments.length}} 条评论</text></view><view class="card comment-form"><text class="label">评论内容</text><textarea class="textarea" maxlength="300" placeholder="留下具体、有帮助的看法" value="{{comment}}" bindinput="inputComment"/><button class="btn-primary btn-wide" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitComment">发表评论</button></view><view wx:if="{{!comments.length}}" class="empty"><text class="empty-mark">评论</text>还没有人评论</view><view wx:for="{{comments}}" wx:key="id" class="card comment"><view class="row between"><view class="row"><view class="avatar mini" style="background:{{item.user.color}}">{{item.user.initial}}</view><view><view class="title small-title">{{item.user.name}}</view><view class="muted small">{{item.createdText}}</view></view></view><text wx:if="{{item.canDelete}}" class="delete-link" data-id="{{item.id}}" bindtap="deleteComment">删除</text></view><view class="comment-text">{{item.text}}</view></view></block></view>
