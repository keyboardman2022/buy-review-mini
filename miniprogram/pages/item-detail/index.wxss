.detail-card { padding: 30rpx; border-radius: 30rpx; background: #fff; }.detail-title { margin-top: 42rpx; font-size: 44rpx; line-height: 1.35; font-weight: 900; }.detail-price { margin-top: 14rpx; font-size: 50rpx; font-weight: 900; font-variant-numeric: tabular-nums; }.reason { margin-top: 30rpx; color: #50545a; line-height: 1.8; }.category { margin-top: 22rpx; }.link-box { margin-top: 24rpx; padding: 20rpx; border-radius: 16rpx; color: #73777e; background: #f5f6f8; font-size: 24rpx; word-break: break-all; }.reaction-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 28rpx; }.reaction { color: #676b72; background: #f2f3f5; }.reaction.positive { color: #168653; background: #eaf8f1; }.reaction.negative { color: #cc4931; background: #fff0ed; }.owner-actions { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 12rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #eff0f2; }.comment-box { padding: 28rpx; border-radius: 24rpx; background: #fff; }.comment-card { margin-top: 16rpx; padding: 26rpx; border-radius: 22rpx; background: #fff; }.comment-text { margin: 20rpx 0 0 76rpx; color: #3f4247; line-height: 1.7; }.delete-link { color: #c94a33; font-size: 24rpx; }

.copy-link { width:100%; text-align:left; font-size:26rpx; min-height:76rpx; line-height:76rpx; color:#a4532f; background:#fff2e8; padding:0 20rpx; }
