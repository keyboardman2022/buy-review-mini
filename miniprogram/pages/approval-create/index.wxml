<view class="page create-page">
  <view class="page-header"><view><view class="page-title">发起审批</view><view class="page-subtitle">选商品、选朋友、定规则</view></view></view>
  <view wx:if="{{loading}}" class="loading">正在准备…</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{!loading}}"><view class="step-head"><text>01</text><view><view>选择商品</view><label>从想买清单中选择</label></view></view><view wx:if="{{!items.length}}" class="empty"><text class="empty-mark">先记下一个想买的东西</text><button class="btn-accent btn-wide" bindtap="addItem">添加商品</button></view><scroll-view scroll-x class="product-scroll"><view class="product-list"><view wx:for="{{items}}" wx:key="id" class="product-choice {{itemId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseItem"><view class="choice-title">{{item.title}}</view><view class="choice-price">{{item.priceText}}</view><view class="muted small clamp">{{item.reason}}</view><view wx:if="{{itemId === item.id}}" class="selected-label">已选择</view></view></view></scroll-view>
  <view class="step-head"><text>02</text><view><view>邀请朋友</view><label>已选 {{selectedIds.length}} 人，最多 10 人</label></view></view><view wx:if="{{!friends.length}}" class="empty"><text class="empty-mark">还没有好友</text><view>邀请朋友加入后，就能请他们拿主意。</view><button class="btn-accent btn-wide" bindtap="inviteFriends">添加或邀请好友</button></view><view wx:if="{{friends.length}}" class="select-card"><view wx:for="{{friends}}" wx:key="id" class="choice" data-id="{{item.id}}" bindtap="toggleReviewer"><view class="dot {{item.selected ? 'selected' : ''}}"></view><view class="avatar mini" style="background:{{item.color}}">{{item.initial}}</view><view class="grow"><view class="title">{{item.name}}</view><view class="muted small">{{item.code}}</view></view><text class="select-text">{{item.selected ? '已选' : '选择'}}</text></view></view>
  <view class="step-head"><text>03</text><view><view>决定规则</view><label>结果由系统自动计算</label></view></view><view class="rule-grid"><view class="rule-card {{rule === 'veto' ? 'selected' : ''}}" data-rule="veto" bindtap="chooseRule"><view>一票否决</view><text>有人拒绝就不买</text></view><view class="rule-card {{rule === 'majority' ? 'selected' : ''}}" data-rule="majority" bindtap="chooseRule"><view>多数决定</view><text>超过半数同意</text></view><view class="rule-card {{rule === 'unanimous' ? 'selected' : ''}}" data-rule="unanimous" bindtap="chooseRule"><view>全员一致</view><text>所有人都同意</text></view></view>
  <button class="btn-accent btn-wide submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">发给朋友审批</button></block>
</view>
