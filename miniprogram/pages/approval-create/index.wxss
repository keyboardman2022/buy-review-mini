.create-page { padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); }.step-head { display: flex; align-items: center; margin: 44rpx 0 20rpx; }.step-head>text { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; margin-right: 18rpx; border-radius: 18rpx; color: #fff; background: #17181a; font-size: 23rpx; font-weight: 800; }.step-head view view { font-size: 32rpx; font-weight: 800; }.step-head label { display: block; margin-top: 4rpx; color: #9599a0; font-size: 24rpx; }.product-scroll { width: 100%; white-space: nowrap; }.product-list { display: flex; padding-bottom: 6rpx; }.product-choice { position: relative; box-sizing: border-box; flex-shrink: 0; width: 330rpx; min-height: 230rpx; margin-right: 16rpx; padding: 26rpx; border: 3rpx solid transparent; border-radius: 24rpx; background: #fff; white-space: normal; }.product-choice.selected { border-color: #ff6436; }.choice-title { font-size: 31rpx; font-weight: 800; }.choice-price { margin: 16rpx 0; font-size: 36rpx; font-weight: 900; }.clamp { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.selected-label { position: absolute; right: 18rpx; bottom: 16rpx; color: #ff6436; font-size: 22rpx; font-weight: 700; }.select-card { padding: 4rpx 26rpx; border-radius: 24rpx; background: #fff; }.select-text { color: #9a9ea5; font-size: 24rpx; }.rule-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; }.rule-card { min-height: 150rpx; padding: 22rpx 18rpx; border: 3rpx solid transparent; border-radius: 22rpx; background: #fff; }.rule-card view { font-size: 27rpx; font-weight: 800; }.rule-card text { display: block; margin-top: 14rpx; color: #92969d; font-size: 22rpx; line-height: 1.5; }.rule-card.selected { border-color: #ff6436; background: #fff8f5; }.rule-card.selected view { color: #e9552c; }.submit { margin-top: 40rpx; }
