.channel { display: flex; align-items: center; margin-bottom: 26rpx; padding: 24rpx; border-radius: 22rpx; color: #fff; background: #17181a; }.channel-dot { width: 22rpx; height: 22rpx; margin-right: 20rpx; border-radius: 50%; background: #1fc876; box-shadow: 0 0 0 10rpx rgba(31,200,118,.12); }.channel-dot.mock { background: #ff8b66; box-shadow: 0 0 0 10rpx rgba(255,139,102,.12); }.channel text { display: block; margin-top: 5rpx; color: rgba(255,255,255,.55); font-size: 23rpx; }.message-card { display: flex; gap: 20rpx; margin-bottom: 16rpx; padding: 26rpx; border-radius: 24rpx; background: #fff; }.message-icon { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 20rpx; color: #fff; background: #17181a; font-weight: 800; }.message-icon.result { background: #ff6436; }.message-type { font-weight: 800; }.message-body { margin: 18rpx 0; color: #494d53; line-height: 1.65; }
