<view class="page">
  <view class="page-header"><view><view class="page-title">提醒记录</view><view class="page-subtitle">审批短信和本地通知状态</view></view></view>
  <view class="channel"><view class="channel-dot {{smsProvider === 'mock' ? 'mock' : ''}}"></view><view><view>{{smsProvider === 'mock' ? '本地模拟通道' : '短信发送通道'}}</view><text>{{mode === 'demo' ? '不会发送真实短信，也不会产生费用' : '提交给短信供应商后显示发送状态'}}</text></view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在读取提醒…</view><view wx:elif="{{!messages.length}}" class="empty"><text class="empty-mark">暂无提醒</text><view>发起审批后，相关通知会显示在这里。</view></view>
  <view wx:for="{{messages}}" wx:key="id" class="message-card" data-id="{{item.approvalId}}" bindtap="openApproval"><view class="message-icon {{item.kind}}">{{item.kind === 'review' ? '审' : '果'}}</view><view class="grow"><view class="row between"><view class="message-type">{{item.kind === 'review' ? '审批邀请' : '审批结果'}}</view><text class="status {{item.status}}">{{item.statusText}}</text></view><view class="message-body">{{item.body}}</view><view class="row between muted small"><text>{{item.direction === 'received' ? '发给我' : '发给 ' + item.recipientName}}</text><text>{{item.timeText}}</text></view></view></view>
</view>
