.feed-card { margin-bottom: 24rpx; padding: 28rpx 28rpx 10rpx; border: 1rpx solid #eceef1; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(20,24,30,.04); }.product { margin-top: 28rpx; }.product-head { align-items: flex-start; }.product-title { padding-right: 20rpx; font-size: 36rpx; font-weight: 800; line-height: 1.35; }.feed-actions { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 26rpx; border-top: 1rpx solid #eff0f2; }.action { min-height: 82rpx; padding: 0; color: #73777e; background: transparent; font-size: 25rpx; line-height: 82rpx; }.action text { margin-left: 5rpx; font-variant-numeric: tabular-nums; }.action.active { color: #15935a; }.action.down { color: #d14b31; }.retry { float: right; font-weight: 700; }
