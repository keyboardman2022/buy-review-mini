<view class="page login-page">
  <view class="hero">
    <view class="eyebrow">BUY WITH CONFIDENCE</view>
    <view class="hero-title">买之前，先问问<br/>你信任的人</view>
    <view class="hero-copy">好友购物清单、投票审批和意见，都只在彼此之间流转。</view>
  </view>
  <view class="card login-card">
    <view class="section-title no-margin">手机号登录</view>
    <view class="field"><text class="label">手机号</text><input class="input" type="number" maxlength="11" placeholder="用于注册或登录" value="{{phone}}" bindinput="inputPhone" /></view>
    <view class="field"><text class="label">昵称（首次注册可填）</text><input class="input" maxlength="20" placeholder="例如：小满" value="{{name}}" bindinput="inputName" /></view>
    <view class="field"><text class="label">验证码</text><view class="row"><input class="input code-input" type="number" maxlength="6" placeholder="短信验证码" value="{{code}}" bindinput="inputCode" /><button class="btn-ghost code-btn" disabled="{{sending || countdown}}" bindtap="sendCode">{{countdown ? countdown + 's' : '获取验证码'}}</button></view></view>
    <view wx:if="{{demoCode}}" class="notice">本地演示验证码：{{demoCode}}</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="btn-primary btn-wide" loading="{{submitting}}" disabled="{{submitting}}" bindtap="login">进入买前问问</button>
  </view>
  <view class="section-title"><text>快速体验</text><text class="section-subtitle">三个虚构账号可随时切换</text></view>
  <view class="demo-grid">
    <button class="demo-card" data-account="a" disabled="{{submitting}}" bindtap="demoLogin"><text class="demo-letter">A</text><text>小满</text></button>
    <button class="demo-card" data-account="b" disabled="{{submitting}}" bindtap="demoLogin"><text class="demo-letter alt">B</text><text>阿禾</text></button>
    <button class="demo-card" data-account="c" disabled="{{submitting}}" bindtap="demoLogin"><text class="demo-letter coral">C</text><text>可可</text></button>
  </view>
  <view class="legal">本地演示环境 · 不发送真实短信</view>
</view>
