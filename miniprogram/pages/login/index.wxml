<view class="login-page">
  <view class="brand-orbit"><view class="brand-mark">问</view></view>
  <view class="login-title">买前问问</view>
  <view class="login-copy">花钱之前，听听真正了解你的朋友怎么说。</view>
  <view wx:if="{{loading}}" class="login-state"><view class="pulse"></view><text>正在通过微信安全登录</text></view>
  <view wx:else class="retry-card">
    <view class="retry-title">暂时没能登录</view>
    <view class="retry-copy">{{error}}</view>
    <button class="btn-primary btn-wide" bindtap="wechatLogin">重新登录</button>
  </view>
  <view class="login-foot">无需注册 · 不读取微信好友列表</view>
</view>
