.login-page { padding-top: 40rpx; }
.login-card { margin-top: 28rpx; }
.no-margin { margin: 0 0 28rpx; }
.code-input { flex: 1; }
.code-btn { flex-shrink: 0; margin-left: 14rpx; }
.demo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.demo-card { display: flex; flex-direction: column; align-items: center; padding: 24rpx 8rpx; color: #173f3e; background: #fffdf8; }
.demo-letter { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin-bottom: 12rpx; border-radius: 23rpx; color: white; background: #0f5c56; }
.demo-letter.alt { background: #b48a49; }.demo-letter.coral { background: #d95f45; }
.legal { margin-top: 40rpx; text-align: center; color: #5f6964; font-size: 26rpx; }
