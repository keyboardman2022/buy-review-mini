page { background: #121315; }
.login-page { display: flex; box-sizing: border-box; min-height: 100vh; padding: 160rpx 54rpx calc(60rpx + env(safe-area-inset-bottom)); flex-direction: column; align-items: center; color: #fff; background: radial-gradient(circle at 50% 20%, #33353a 0, #17181b 42%, #101113 100%); }
.brand-orbit { display: flex; align-items: center; justify-content: center; width: 190rpx; height: 190rpx; border: 2rpx solid rgba(255,255,255,.12); border-radius: 50%; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 128rpx; height: 128rpx; border-radius: 38rpx; color: #fff; background: #ff6436; box-shadow: 0 20rpx 50rpx rgba(255,100,54,.3); font-size: 60rpx; font-weight: 900; transform: rotate(-6deg); }
.login-title { margin-top: 54rpx; font-size: 58rpx; font-weight: 800; letter-spacing: 3rpx; }
.login-copy { max-width: 560rpx; margin-top: 24rpx; color: rgba(255,255,255,.62); text-align: center; font-size: 29rpx; line-height: 1.8; }
.login-state { display: flex; align-items: center; margin-top: 88rpx; color: rgba(255,255,255,.7); font-size: 27rpx; }
.pulse { width: 18rpx; height: 18rpx; margin-right: 18rpx; border-radius: 50%; background: #ff6436; box-shadow: 0 0 0 12rpx rgba(255,100,54,.12); }
.retry-card { box-sizing: border-box; width: 100%; margin-top: 70rpx; padding: 30rpx; border-radius: 24rpx; color: #202226; background: #fff; }
.retry-title { font-size: 32rpx; font-weight: 800; }.retry-copy { margin-top: 12rpx; color: #777b82; line-height: 1.6; }
.login-foot { margin-top: auto; color: rgba(255,255,255,.38); font-size: 24rpx; }
