.receipt-page { background:#f4f3ef; }
.receipt { position:relative; padding:32rpx; border-radius:24rpx 24rpx 8rpx 8rpx; background:#fff; box-shadow:0 10rpx 32rpx rgba(44,35,23,.05); }
.receipt::after { content:''; position:absolute; left:0; right:0; bottom:-10rpx; height:12rpx; background:linear-gradient(135deg,#fff 25%,transparent 25%) -12rpx 0,linear-gradient(225deg,#fff 25%,transparent 25%) -12rpx 0; background-size:24rpx 24rpx; }
.receipt-brand { font-size:25rpx; color:#54534e; font-weight:700; }.receipt-number { font-size:23rpx; color:#76756f; }
.receipt-heading { display:flex; align-items:center; gap:22rpx; margin-top:36rpx; }.result-title { font-size:40rpx; font-weight:800; line-height:1.4; overflow-wrap:break-word; }.result-price { margin-top:12rpx; font-size:50rpx; font-weight:800; }
.receipt-stamp { flex-shrink:0; max-width:148rpx; padding:16rpx 12rpx; border:3rpx solid currentColor; border-radius:12rpx; color:#a76b19; background:#fff8e9; font-size:26rpx; font-weight:700; text-align:center; transform:rotate(-8deg); }
.receipt-stamp.approved { color:#19724b; background:#edf8ef; }.receipt-stamp.rejected { color:#ac4c32; background:#fff1e9; }.receipt-stamp.expired,.receipt-stamp.cancelled { color:#73716a; background:#f4f3f0; }
.result-reason { margin-top:26rpx; color:#595950; line-height:1.75; white-space:pre-wrap; overflow-wrap:break-word; }.receipt-tear { margin:30rpx -32rpx 24rpx; border-top:2rpx dashed #e4e1da; }.receipt-line { display:flex; justify-content:space-between; gap:20rpx; margin:14rpx 0; font-size:25rpx; color:#69685f; }.receipt-line text:last-child { text-align:right; color:#33352d; }
.vote-counts { display:flex; justify-content:space-between; margin-top:12rpx; font-size:23rpx; color:#707166; }.receipt-summary { margin-top:22rpx; padding:20rpx; border-radius:14rpx; background:#f8f6f1; color:#55574d; font-size:26rpx; line-height:1.6; }
.vote-card { margin-top:36rpx; padding:28rpx; border-radius:24rpx; background:#fff; }.vote-title { font-size:34rpx; font-weight:800; }.vote-sub { margin:10rpx 0 22rpx; color:#72776e; font-size:25rpx; }.vote-actions { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; margin-top:20rpx; }
.review-list { padding:4rpx 26rpx; border-radius:24rpx; background:#fff; }.review-item { padding:26rpx 0; border-bottom:1rpx solid #eff0ed; }.review-item:last-child { border:0; }.review-comment { margin:18rpx 0 0 76rpx; padding:18rpx 20rpx; border-radius:0 16rpx 16rpx; background:#f5f6f2; color:#454b41; line-height:1.65; overflow-wrap:break-word; }
.withdraw { margin:28rpx auto 0; color:#8b6458; background:transparent; font-size:26rpx; }.vote-dock { position:fixed; bottom:0; left:0; right:0; z-index:10; display:flex; justify-content:space-between; align-items:center; padding:18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #edeae3; background:#fff; }.vote-dock text { font-size:25rpx; color:#65675f; }.share-canvas { position:fixed; left:-2000px; top:0; pointer-events:none; }
