.result-card { padding: 34rpx; border-radius: 30rpx; color: #fff; background: #17181a; box-shadow: 0 18rpx 42rpx rgba(15,17,20,.18); }.result-card.approved { background: #137d4d; }.result-card.rejected,.result-card.cancelled { background: #b94431; }.result-card.expired { background: #565a61; }.result-label { font-size: 27rpx; font-weight: 800; }.result-rule { color: rgba(255,255,255,.58); font-size: 24rpx; }.result-title { margin-top: 44rpx; font-size: 43rpx; font-weight: 900; line-height: 1.35; }.result-price { margin-top: 12rpx; font-size: 52rpx; font-weight: 900; }.result-reason { margin-top: 28rpx; color: rgba(255,255,255,.72); line-height: 1.75; }.result-card .media { background: rgba(255,255,255,.1); }.result-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 30rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.13); }.result-meta text,.result-meta-value { display: block; }.result-meta text { color: rgba(255,255,255,.48); font-size: 23rpx; }.result-meta-value { margin-top: 7rpx; font-size: 25rpx; font-weight: 700; }.review-list { padding: 4rpx 28rpx; border-radius: 24rpx; background: #fff; }.review-item { padding: 26rpx 0; border-bottom: 1rpx solid #eff0f2; }.review-item:last-child { border: 0; }.review-comment { margin: 18rpx 0 0 76rpx; padding: 18rpx 20rpx; border-radius: 16rpx; color: #464a50; background: #f5f6f8; line-height: 1.65; }.vote-card { margin-top: 26rpx; padding: 28rpx; border-radius: 26rpx; background: #fff; }.vote-title { font-size: 34rpx; font-weight: 800; }.vote-sub { margin: 8rpx 0 22rpx; color: #92969d; font-size: 25rpx; }.vote-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 18rpx; }.owner-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 24rpx; }
