.approval-head { margin-top: 16rpx; }.detail-title { margin-top: 26rpx; font-size: 42rpx; font-weight: 800; }.facts { display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #e8e3da; }.facts view { min-width: 0; }.facts text,.facts strong { display: block; }.facts text { margin-bottom: 8rpx; color: #5f6964; font-size: 26rpx; }.facts strong { font-size: 28rpx; }.reviewer-list { padding-top: 4rpx; padding-bottom: 4rpx; }.reviewer { padding: 24rpx 0; border-bottom: 1rpx solid #eee8de; }.reviewer:last-child { border-bottom: 0; }.mini { width: 60rpx; height: 60rpx; border-radius: 18rpx; }.review-comment { margin: 18rpx 0 0 78rpx; line-height: 1.65; }.vote-box { margin-top: 32rpx; }.vote-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }
