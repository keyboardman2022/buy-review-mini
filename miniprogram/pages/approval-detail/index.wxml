<view class="page">
  <view wx:if="{{loading}}" class="loading">正在读取审批…</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{approval}}"><view class="result-card {{approval.status}}"><view class="row between"><text class="result-label">{{approval.statusText}}</text><text class="result-rule">{{approval.ruleText}}</text></view><view class="result-title">{{approval.title}}</view><view class="result-price">{{approval.priceText}}</view><view class="result-reason">{{approval.reason}}</view><view class="media-grid"><image wx:for="{{approval.photos}}" wx:key="*this" class="media" src="{{item}}" mode="aspectFill"/></view><view class="result-meta"><view><text>发起人</text><view class="result-meta-value">{{approval.owner.name}}</view></view><view><text>截止</text><view class="result-meta-value">{{approval.expiresText}}</view></view></view></view>
  <view class="section-title"><text>审批进度</text><text class="section-subtitle">{{approval.reviewers.length}} 位朋友</text></view><view class="review-list"><view wx:for="{{approval.reviewers}}" wx:key="id" class="review-item"><view class="row"><view class="avatar mini" style="background:{{item.user.color}}">{{item.user.initial}}</view><view class="grow"><view class="title">{{item.user.name}}</view><view class="muted small">{{item.votedText || '等待回复'}}</view></view><text class="status {{item.decision || 'pending'}}">{{item.decisionText}}</text></view><view wx:if="{{item.comment}}" class="review-comment">{{item.comment}}</view></view></view>
  <view wx:if="{{canVote}}" class="vote-card"><view class="vote-title">你的决定</view><view class="vote-sub">请留下具体理由，发起人会看到。</view><textarea class="textarea" maxlength="300" placeholder="说说为什么可以买，或为什么应该等等" value="{{comment}}" bindinput="inputComment"/><view class="vote-actions"><button class="btn-success" data-decision="accept" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitVote">支持购买</button><button class="btn-danger" data-decision="reject" disabled="{{submitting}}" bindtap="submitVote">建议别买</button></view></view>
  <view wx:if="{{isOwner && approval.status === 'pending'}}" class="owner-row"><button class="btn-danger" disabled="{{submitting}}" bindtap="cancel">撤回审批</button><button class="btn-soft" open-type="share">转发提醒</button></view></block>
</view>
