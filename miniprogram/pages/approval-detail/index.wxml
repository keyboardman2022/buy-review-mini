<view class="page">
  <view wx:if="{{loading}}" class="loading">正在读取审批…</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <block wx:if="{{approval}}">
    <view class="card approval-head">
      <view class="row between"><text class="status {{approval.status}}">{{approval.statusText}}</text><text class="price">{{approval.priceText}}</text></view>
      <view class="detail-title">{{approval.title}}</view>
      <view class="meta">{{approval.reason}}</view>
      <view class="media-grid"><image wx:for="{{approval.photos}}" wx:key="*this" class="media" src="{{item}}" mode="aspectFill"/></view>
      <view class="facts"><view><text>发起人</text><strong>{{approval.owner.name}}</strong></view><view><text>决定规则</text><strong>{{approval.ruleText}}</strong></view><view><text>截止时间</text><strong>{{approval.expiresText}}</strong></view></view>
    </view>
    <view class="section-title"><text>好友意见</text><text class="section-subtitle">{{approval.reviewers.length}} 位审批人</text></view>
    <view class="card reviewer-list"><view wx:for="{{approval.reviewers}}" wx:key="id" class="reviewer"><view class="row between"><view class="row grow"><view class="avatar mini" style="background:{{item.user.color}}">{{item.user.initial}}</view><view><view class="title">{{item.user.name}}</view><view class="muted small">{{item.votedText || '尚未提交'}}</view></view></view><text class="status {{item.decision || 'pending'}}">{{item.decisionText}}</text></view><view wx:if="{{item.comment}}" class="review-comment">{{item.comment}}</view></view></view>
    <view wx:if="{{canVote}}" class="card vote-box"><text class="label">审批意见（必填）</text><textarea class="textarea" maxlength="300" placeholder="说明为什么适合买，或为什么应该再等等" value="{{comment}}" bindinput="inputComment"/><view class="vote-actions"><button class="btn-primary" data-decision="accept" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitVote">接受购买</button><button class="btn-coral" data-decision="reject" disabled="{{submitting}}" bindtap="submitVote">拒绝购买</button></view></view>
    <view wx:if="{{isOwner && approval.status === 'pending'}}" class="actions"><button class="btn-danger" disabled="{{submitting}}" bindtap="cancel">撤回审批</button><button class="btn-ghost" open-type="share">转发给审批人</button></view>
  </block>
</view>
