<view class="page"><view class="hero compact"><view class="eyebrow">NEW WISH</view><view class="hero-title">{{id ? '修改这件心愿' : '记下一件想买的东西'}}</view></view><view wx:if="{{loading}}" class="loading">正在读取商品…</view><view wx:if="{{error}}" class="error">{{error}}</view>
<view class="form-card"><view class="field"><text class="label">商品名称 *</text><input class="input" maxlength="60" placeholder="例如：降噪耳机" value="{{title}}" data-field="title" bindinput="inputField"/></view><view class="field"><text class="label">价格（元）*</text><input class="input" type="digit" placeholder="0.00" value="{{price}}" data-field="price" bindinput="inputField"/></view><view class="field"><text class="label">为什么想买 *</text><textarea class="textarea" maxlength="500" placeholder="用途、犹豫的地方，越具体越容易得到好建议" value="{{reason}}" data-field="reason" bindinput="inputField"/></view><view class="two"><view class="field"><text class="label">分类</text><input class="input" maxlength="30" placeholder="数码 / 家居" value="{{category}}" data-field="category" bindinput="inputField"/></view><view class="field"><text class="label">商品链接</text><input class="input" maxlength="500" placeholder="选填" value="{{link}}" data-field="link" bindinput="inputField"/></view></view>
<view class="field"><text class="label">谁能看到</text><view class="visibility"><view class="visibility-card {{visibility === 'friends' ? 'selected' : ''}}" data-value="friends" bindtap="chooseVisibility"><text>好友可见</text><label>出现在好友购物圈</label></view><view class="visibility-card {{visibility === 'private' ? 'selected' : ''}}" data-value="private" bindtap="chooseVisibility"><text>仅自己</text><label>审批人仍可看快照</label></view></view></view>
<view class="field"><text class="label">图片（最多3张，单张3MB）</text><view class="media-grid"><view wx:for="{{previews}}" wx:key="*this" class="preview-wrap"><image class="media" src="{{item}}" mode="aspectFill"/><view class="remove" data-index="{{index}}" bindtap="removeImage">移除</view></view><view wx:if="{{previews.length < 3}}" class="image-add" bindtap="chooseImages">{{uploading ? '上传中' : '添加\n图片'}}</view></view></view><button class="btn-primary btn-wide" loading="{{submitting}}" disabled="{{submitting || uploading}}" bindtap="submit">{{id ? '保存修改' : '加入购物车'}}</button></view></view>
