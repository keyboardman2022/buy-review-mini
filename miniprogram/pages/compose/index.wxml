<view class="page form-page">
  <view class="page-header"><view><view class="page-title">{{id ? '编辑商品' : '添加想买'}}</view><view class="page-subtitle">把用途和犹豫写清楚，朋友才好判断</view></view></view>
  <view wx:if="{{loading}}" class="loading">正在读取商品…</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="form-card">
    <view class="field"><text class="label">商品名称 <text class="required">必填</text></text><input class="input" maxlength="60" placeholder="例如：降噪耳机" value="{{title}}" data-field="title" bindinput="inputField"/></view>
    <view class="field"><text class="label">价格 <text class="required">必填</text></text><view class="price-input"><text>¥</text><input type="digit" placeholder="0.00" value="{{price}}" data-field="price" bindinput="inputField"/></view></view>
    <view class="field"><text class="label">为什么想买 <text class="required">必填</text></text><textarea class="textarea" maxlength="500" placeholder="准备怎么用？现在为什么犹豫？" value="{{reason}}" data-field="reason" bindinput="inputField"/></view>
    <view class="field"><text class="label">分类</text><input class="input" maxlength="20" placeholder="例如：数码、家居、穿搭" value="{{category}}" data-field="category" bindinput="inputField"/></view>
    <view class="field"><text class="label">商品链接</text><input class="input" maxlength="500" placeholder="选填，以 http 或 https 开头" value="{{link}}" data-field="link" bindinput="inputField"/></view>
    <view class="field"><text class="label">谁能看到</text><view class="visibility"><view class="visibility-card {{visibility === 'friends' ? 'selected' : ''}}" data-value="friends" bindtap="chooseVisibility"><text>好友可见</text><label>会出现在购物圈</label></view><view class="visibility-card {{visibility === 'private' ? 'selected' : ''}}" data-value="private" bindtap="chooseVisibility"><text>仅自己</text><label>审批人可看快照</label></view></view></view>
    <view class="field"><view class="row between"><text class="label">商品图片</text><text class="muted small">{{previews.length}} / 3</text></view><view class="media-grid"><view wx:for="{{previews}}" wx:key="*this" class="preview"><image class="media" src="{{item}}" mode="aspectFill"/><view class="remove" data-index="{{index}}" bindtap="removeImage">移除</view></view><view wx:if="{{previews.length < 3}}" class="add-photo" bindtap="chooseImages"><text>{{uploading ? '上传中' : '添加图片'}}</text><label>相册或拍照</label></view></view></view>
  </view>
  <button class="btn-primary btn-wide submit" loading="{{submitting}}" disabled="{{submitting || uploading}}" bindtap="submit">{{id ? '保存修改' : '加入想买清单'}}</button>
</view>
