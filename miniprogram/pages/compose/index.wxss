.form-page { padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); }.form-card { padding: 30rpx; border-radius: 28rpx; background: #fff; }.price-input { display: flex; align-items: center; min-height: 104rpx; padding: 0 24rpx; border: 2rpx solid #e7e9ec; border-radius: 18rpx; background: #fafbfc; }.price-input text { margin-right: 14rpx; font-size: 38rpx; font-weight: 800; }.price-input input { flex: 1; height: 104rpx; font-size: 38rpx; font-weight: 800; }.visibility { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.visibility-card { min-height: 104rpx; padding: 22rpx; border: 2rpx solid #e7e9ec; border-radius: 18rpx; }.visibility-card text,.visibility-card label { display: block; }.visibility-card text { font-weight: 700; }.visibility-card label { margin-top: 7rpx; color: #94989f; font-size: 23rpx; }.visibility-card.selected { border-color: #17181a; background: #f2f3f5; }.preview { position: relative; }.remove { position: absolute; right: 8rpx; top: 8rpx; min-height: 50rpx; padding: 0 14rpx; border-radius: 25rpx; color: #fff; background: rgba(17,18,20,.75); font-size: 22rpx; line-height: 50rpx; }.add-photo { display: flex; width: 190rpx; height: 190rpx; border: 2rpx dashed #d4d7dc; border-radius: 18rpx; align-items: center; justify-content: center; flex-direction: column; color: #454950; background: #fafbfc; }.add-photo text { font-weight: 700; }.add-photo label { margin-top: 8rpx; color: #a0a4aa; font-size: 22rpx; }.submit { margin-top: 28rpx; }

.media-grid { flex-wrap:wrap; overflow:visible; }.media,.add-photo { width:176rpx; height:176rpx; }
