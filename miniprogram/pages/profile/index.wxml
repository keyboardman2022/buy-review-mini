<view class="page">
  <view wx:if="{{loading}}" class="loading">正在读取你的资料…</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{user}}"><view class="profile-head"><view class="avatar big" style="background:{{user.color}}">{{user.initial}}</view><view class="grow"><view wx:if="{{!editing}}" class="profile-name">{{user.name}} <text class="edit" bindtap="startEdit">编辑</text></view><view wx:else class="row"><input class="input name-input" value="{{name}}" maxlength="20" bindinput="inputName"/><button class="btn-primary save" bindtap="saveName">保存</button></view><view class="muted">{{user.phoneMasked}} · 编号 {{user.code}}</view></view></view>
  <view class="stats"><view><text>{{stats.cartCount || 0}}</text><label>购物清单</label></view><view><text>{{stats.pendingCount || 0}}</text><label>待审批</label></view><view><text>{{stats.friendCount || 0}}</text><label>好友</label></view></view>
  <view class="card menu"><view class="menu-row" bindtap="openFriends"><text>好友与邀请</text><text class="arrow">{{stats.friendCount || 0}} 人 ›</text></view><view class="menu-row" bindtap="openMessages"><text>短信中心</text><text class="arrow">查看记录 ›</text></view><button class="share-row" open-type="share"><text>分享我的邀请码</text><text class="arrow">{{user.code}} ›</text></button></view>
  <view wx:if="{{mode === 'demo'}}"><view class="section-title"><text>切换演示身份</text><text class="section-subtitle">数据由服务端保留</text></view><view class="demo-switch"><button data-account="a" disabled="{{switching}}" bindtap="switchDemo">小满</button><button data-account="b" disabled="{{switching}}" bindtap="switchDemo">阿禾</button><button data-account="c" disabled="{{switching}}" bindtap="switchDemo">可可</button></view></view>
  <view class="notice small">当前模式：{{mode}} · 短信：{{smsProvider}}</view><button class="btn-danger btn-wide" bindtap="logout">退出登录</button></block>
</view>
