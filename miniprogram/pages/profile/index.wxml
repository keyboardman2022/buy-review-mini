<view class="page">
  <view class="page-header"><view><view class="page-kicker">ACCOUNT</view><view class="page-title">我的</view></view></view>
  <view wx:if="{{loading}}" class="loading">正在读取资料…</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{user}}"><view class="identity-card"><view class="row"><view class="avatar profile-avatar" style="background:{{user.color}}">{{user.initial}}</view><view class="grow"><view wx:if="{{!editing}}" class="identity-name">{{user.name}}</view><view wx:else class="row"><input class="name-input" value="{{name}}" maxlength="20" bindinput="inputName"/><button class="save-button" bindtap="saveName">保存</button></view><view class="identity-sub">{{user.phoneMasked}}</view></view><button wx:if="{{!editing}}" class="edit-button" bindtap="startEdit">修改昵称</button></view><button wx:if="{{!user.hasPhone && mode !== 'demo'}}" class="phone-auth" open-type="getPhoneNumber" bindgetphonenumber="bindPhone">授权手机号，开启短信提醒</button><view class="invite"><view><view class="invite-label">我的好友邀请码</view><view class="invite-code">{{user.code}}</view></view><button open-type="share">分享</button></view></view>
  <view class="stats"><view><text>{{stats.cartCount || 0}}</text><label>想买</label></view><view><text>{{stats.pendingCount || 0}}</text><label>待审批</label></view><view><text>{{stats.friendCount || 0}}</text><label>好友</label></view></view>
  <view class="menu"><view class="menu-row" bindtap="openFriends"><view><view class="menu-title">好友与邀请</view><view class="menu-sub">管理好友和待处理申请</view></view><text>{{stats.friendCount || 0}}</text></view><view class="menu-row" bindtap="openMessages"><view><view class="menu-title">提醒记录</view><view class="menu-sub">查看审批通知状态</view></view><text>查看</text></view></view>
  <view class="mode-note">当前为 {{mode}} 模式 · 通知通道 {{smsProvider}}</view></block>
</view>
