.identity-card { padding: 30rpx; border-radius: 30rpx; color: #fff; background: #17181a; box-shadow: 0 18rpx 42rpx rgba(16,18,21,.18); }.profile-avatar { width: 94rpx; height: 94rpx; font-size: 36rpx; }.identity-name { font-size: 39rpx; font-weight: 800; }.identity-sub { margin-top: 8rpx; color: rgba(255,255,255,.55); font-size: 25rpx; }.edit-button { min-height: 64rpx; padding: 0 18rpx; color: rgba(255,255,255,.76); background: rgba(255,255,255,.1); font-size: 24rpx; line-height: 64rpx; }.name-input { flex: 1; min-height: 70rpx; padding: 0 18rpx; border-radius: 14rpx; color: #17181a; background: #fff; }.save-button { min-height: 70rpx; margin-left: 10rpx; padding: 0 16rpx; color: #fff; background: #ff6436; line-height: 70rpx; }.phone-auth { width: 100%; min-height: 72rpx; margin-top: 24rpx; color: #fff; background: rgba(255,255,255,.12); font-size: 24rpx; line-height: 72rpx; }.invite { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; padding-top: 26rpx; border-top: 1rpx solid rgba(255,255,255,.12); }.invite-label { color: rgba(255,255,255,.52); font-size: 23rpx; }.invite-code { margin-top: 6rpx; font-size: 34rpx; font-weight: 800; letter-spacing: 3rpx; }.invite button { min-height: 66rpx; padding: 0 24rpx; color: #17181a; background: #fff; line-height: 66rpx; }.stats { display: grid; grid-template-columns: repeat(3,1fr); margin: 24rpx 0; padding: 26rpx 0; border-radius: 24rpx; background: #fff; }.stats view { text-align: center; border-right: 1rpx solid #eff0f2; }.stats view:last-child { border: 0; }.stats text,.stats label { display: block; }.stats text { font-size: 38rpx; font-weight: 800; }.stats label { margin-top: 5rpx; color: #90949b; font-size: 24rpx; }.menu { overflow: hidden; border-radius: 24rpx; background: #fff; }.menu-row { display: flex; align-items: center; justify-content: space-between; min-height: 120rpx; margin-left: 28rpx; padding-right: 28rpx; border-bottom: 1rpx solid #eff0f2; }.menu-row:last-child { border: 0; }.menu-title { font-weight: 700; }.menu-sub { margin-top: 7rpx; color: #92969d; font-size: 24rpx; }.menu-row>text { color: #ff6436; font-size: 25rpx; }.mode-note { margin: 28rpx 0; color: #a0a4aa; text-align: center; font-size: 23rpx; }
