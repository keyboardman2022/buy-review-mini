.profile-head { display: flex; align-items: center; margin: 28rpx 8rpx; }.big { width: 108rpx; height: 108rpx; border-radius: 34rpx; font-size: 42rpx; }.profile-name { margin-bottom: 10rpx; font-size: 42rpx; font-weight: 800; }.edit { margin-left: 12rpx; color: #d95f45; font-size: 28rpx; font-weight: 500; }.name-input { flex: 1; padding: 16rpx; }.save { margin-left: 10rpx; }.stats { display: grid; grid-template-columns: repeat(3,1fr); margin: 34rpx 0; padding: 28rpx 0; border-radius: 26rpx; background: #0f5c56; color: white; text-align: center; }.stats text { display: block; font-size: 40rpx; font-weight: 800; }.stats label { color: rgba(255,255,255,.78); font-size: 26rpx; }.menu { padding: 4rpx 28rpx; }.menu-row,.share-row { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; min-height: 100rpx; border-bottom: 1rpx solid #eee8de; color: #173f3e; background: transparent; font-size: 29rpx; text-align: left; }.menu-row:last-child { border-bottom: 0; }.arrow { color: #5f6964; }.demo-switch { display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; }.demo-switch button { color: #0f5c56; background: #e3efeb; }
