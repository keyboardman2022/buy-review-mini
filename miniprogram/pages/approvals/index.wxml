<view class="page">
  <view class="page-header"><view><view class="page-title">朋友拿主意</view><view class="page-subtitle">{{pendingCount ? pendingCount + ' 件想买，等你给点意见' : '每个认真回答，都是一份在意'}}</view></view><button class="round-add accent" bindtap="createApproval">发起</button></view>
  <view class="segmented"><view class="segment {{scope === 'pending' ? 'active' : ''}}" data-scope="pending" bindtap="switchScope">待我审批 {{pendingCount || ''}}</view><view class="segment {{scope === 'handled' ? 'active' : ''}}" data-scope="handled" bindtap="switchScope">已处理</view><view class="segment {{scope === 'sent' ? 'active' : ''}}" data-scope="sent" bindtap="switchScope">我发起</view></view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="btn-soft" bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="loading">正在整理朋友的意见…</view>
  <view wx:elif="{{!approvals.length && !error}}" class="empty"><image class="empty-art" src="/miniprogram/assets/empty-wallet.png"/><text class="empty-mark">{{scope === 'pending' ? '暂时不用你操心' : scope === 'handled' ? '还没有处理记录' : '钱包的事，和朋友聊聊'}}</text><view>{{scope === 'pending' ? '有新的审批邀请，会出现在这里。' : scope === 'handled' ? '已回复或已结束的审批会保存在这里。' : '从想买清单选一件，请朋友拿主意。'}}</view><button wx:if="{{scope === 'sent'}}" class="btn-accent btn-wide" bindtap="createApproval">发起第一次审批</button></view>
  <view wx:for="{{approvals}}" wx:key="id" class="approval-card" data-id="{{item.id}}" bindtap="openApproval">
    <view class="row between"><view class="row grow"><view class="avatar mini" style="background:{{item.owner.color}}">{{item.owner.initial}}</view><view class="grow"><view class="title">{{scope === 'sent' ? '我的购买计划' : item.owner.name}}</view><view class="muted small">{{item.createdText}}</view></view></view><text class="status {{item.status}}">{{item.statusText}}</text></view>
    <view class="approval-product"><image wx:if="{{item.photos.length}}" class="approval-cover" src="{{item.photos[0]}}" mode="aspectFill"/><view class="grow"><view class="approval-title">{{item.title}}</view><text class="price">{{item.priceText}}</text></view></view>
    <view class="vote-meter"><view class="meter-yes" style="width:{{item.yesWidth}}%"></view><view class="meter-no" style="width:{{item.noWidth}}%"></view></view>
    <view class="row between approval-bottom"><text class="small muted">{{item.decidedCount}}/{{item.reviewers.length}} 已回复 · {{item.ruleText}}</text><text class="deadline {{item.urgent ? 'urgent' : ''}}">{{item.deadlineText}}</text></view>
  </view>
</view>
