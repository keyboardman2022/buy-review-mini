<view class="page">
  <view class="page-header"><view><view class="page-kicker">DECISIONS</view><view class="page-title">购买审批</view><view class="page-subtitle">让朋友替冲动踩一下刹车</view></view><button class="round-add accent" bindtap="createApproval">发起</button></view>
  <view class="segmented"><view class="segment {{scope === 'inbox' ? 'active' : ''}}" data-scope="inbox" bindtap="switchScope">等我决定</view><view class="segment {{scope === 'sent' ? 'active' : ''}}" data-scope="sent" bindtap="switchScope">我发起的</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在更新审批…</view>
  <view wx:elif="{{!approvals.length}}" class="empty"><text class="empty-mark">{{scope === 'inbox' ? '暂时没有待办' : '还没有审批'}}</text><view>{{scope === 'inbox' ? '需要你决定的购买申请会出现在这里。' : '从想买清单里选择一件商品发起。'}}</view><button wx:if="{{scope === 'sent'}}" class="btn-primary btn-wide" bindtap="createApproval">发起审批</button></view>
  <view wx:for="{{approvals}}" wx:key="id" class="approval-card" data-id="{{item.id}}" bindtap="openApproval">
    <view class="row between"><view class="row grow"><view class="avatar" style="background:{{item.owner.color}}">{{item.owner.initial}}</view><view class="grow"><view class="title">{{scope === 'inbox' ? item.owner.name : '我发起的'}}</view><view class="muted small">{{item.createdText}}</view></view></view><text class="status {{item.status}}">{{item.statusText}}</text></view>
    <view class="approval-title">{{item.title}}</view><view class="row between approval-bottom"><view><text class="tag orange">{{item.ruleText}}</text><text class="muted small">{{item.decidedCount}}/{{item.reviewers.length}} 已决定</text></view><text class="price">{{item.priceText}}</text></view>
  </view>
</view>
