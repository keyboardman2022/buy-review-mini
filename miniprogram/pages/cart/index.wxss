.round-add { min-width: 112rpx; min-height: 72rpx; padding: 0 24rpx; border-radius: 36rpx; color: #fff; background: #17181a; line-height: 72rpx; }.wish-card { margin-bottom: 20rpx; padding: 26rpx 26rpx 8rpx; border-radius: 26rpx; background: #fff; border: 1rpx solid #eceef1; }.wish-main { display: flex; gap: 22rpx; margin-top: 24rpx; }.wish-title { font-size: 36rpx; font-weight: 800; }.wish-price { margin-top: 20rpx; }.clamp { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.cover { flex-shrink: 0; width: 176rpx; height: 176rpx; border-radius: 20rpx; background: #eef0f2; }.wish-actions { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 20rpx; border-top: 1rpx solid #eff0f2; }.wish-actions button { min-height: 80rpx; padding: 0; color: #676b72; background: transparent; font-size: 25rpx; line-height: 80rpx; }.wish-actions .danger { color: #c94730; }
