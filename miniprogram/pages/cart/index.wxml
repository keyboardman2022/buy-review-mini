<view class="page">
  <view class="page-header"><view><view class="page-kicker">MY WISH LIST</view><view class="page-title">想买清单</view><view class="page-subtitle">先记下来，再决定要不要买</view></view><button class="round-add" bindtap="createItem">添加</button></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在读取清单…</view>
  <view wx:elif="{{!items.length}}" class="empty"><text class="empty-mark">清单还是空的</text><view>把正在犹豫的东西放进来。</view><button class="btn-primary btn-wide" bindtap="createItem">添加第一件商品</button></view>
  <view wx:for="{{items}}" wx:key="id" class="wish-card">
    <view data-id="{{item.id}}" bindtap="openItem"><view class="row between"><text class="tag {{item.visibility === 'private' ? '' : 'green'}}">{{item.visibility === 'private' ? '仅自己' : '好友可见'}}</text><text class="muted small">{{item.timeText}}</text></view><view class="wish-main"><view class="grow"><view class="wish-title">{{item.title}}</view><view class="meta clamp">{{item.reason}}</view><view class="price wish-price">{{item.priceText}}</view></view><image wx:if="{{item.photos[0]}}" class="cover" src="{{item.photos[0]}}" mode="aspectFill"/></view></view>
    <view class="wish-actions"><button data-id="{{item.id}}" bindtap="editItem">编辑</button><button data-id="{{item.id}}" bindtap="openItem">{{item.commentCount}} 条评论</button><button class="danger" data-id="{{item.id}}" loading="{{deletingId === item.id}}" disabled="{{deletingId}}" bindtap="deleteItem">移除</button></view>
  </view>
</view>
