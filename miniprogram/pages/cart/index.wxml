<view class="page">
  <view class="page-header"><view><view class="page-title">想买清单</view><view class="page-subtitle">先记下来，再决定要不要买</view></view><button class="round-add" bindtap="createItem">添加</button></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="loading">正在读取清单…</view>
  <view wx:elif="{{!items.length}}" class="empty"><image class="empty-art" src="/miniprogram/assets/empty-wallet.png"/><text class="empty-mark">钱包暂时很安全</text><view>把正在犹豫的东西放进来。</view><button class="btn-primary btn-wide" bindtap="createItem">添加第一件商品</button></view>
  <view wx:for="{{items}}" wx:key="id" class="wish-card">
    <view data-id="{{item.id}}" bindtap="openItem"><view class="row between"><text class="tag {{item.visibility === 'private' ? '' : 'green'}}">{{item.visibility === 'private' ? '仅自己' : '好友可见'}}</text><text class="muted small">{{item.timeText}}</text></view><view class="wish-main"><view class="grow"><view class="wish-title">{{item.title}}</view><view class="meta clamp">{{item.reason}}</view><view class="price wish-price">{{item.priceText}}</view></view><image wx:if="{{item.photos[0]}}" class="cover" src="{{item.photos[0]}}" mode="aspectFill"/><view wx:else class="cover cover-placeholder"><text>想</text><label>{{item.category || '好物'}}</label></view></view></view>
    <view class="wish-actions"><button class="ask-button" data-id="{{item.id}}" bindtap="askFriends">问问朋友 ↗</button><button data-id="{{item.id}}" bindtap="openItem">{{item.commentCount}} 条评论</button><button data-id="{{item.id}}" disabled="{{deletingId}}" bindtap="moreActions">更多 ···</button></view>
  </view>
</view>
